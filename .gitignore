node_modules/
bundle.js
bundle.js.map
.claude/hook-counter
.claude/last-violations.txt
.claude/last-estimate-warnings.txt
.claude/violations-log.txt
.claude/settings.local.json
.claude/.byyou-release

# AI-тестер скріншоти — тільки на сервері Hetzner, base64 у tester-status.json
# для фейлів. Інакше репо росте на 1.5 GB/рік.
_ai-tools/tester-screenshots/*.png
_ai-tools/tester-screenshots/*.jpg
_ai-tools/tester-screenshots/*.jpeg

# Python bytecode (scripts/ai-tester.py compiles during syntax check)
scripts/__pycache__/
**/__pycache__/

# Playwright E2E артефакти (звіт + сліди) — генеруються щопрогону, у CI як artifact
playwright-report/
test-results/
.claude/hooks/logs/
.claude/hooks/.byyou-handoff-warned
.claude/hooks/.token-guard-tripped
